# First run can use Fake mode without paid APIs. Existing .env is never overwritten.
ENVIRONMENT=development
LLM_MODE=fake
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://research_user:change_me@localhost:5432/research_db
REDIS_URL=redis://localhost:6379/0

# For real research, set LLM_MODE=real and choose an available model ID for each role.
CUSTOM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
MODEL_PLANNER=custom:<model-id>
MODEL_EXECUTOR=custom:<model-id>
MODEL_CRITIC=custom:<model-id>
MODEL_SYNTHESIZER=custom:<model-id>
MODEL_CHAT=custom:<model-id>

# Inference and embeddings are independent. Fake mode always uses local fake embeddings.
EMBEDDINGS_PROVIDER=google
EMBEDDINGS_MODEL=gemini-embedding-001
# OpenRouter alternative: openrouter / openai/text-embedding-3-small
# Docker-hosted local model services must use an explicit host.docker.internal URL.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
RESEARCH_API_PROXY=

MAX_PARALLEL_TASKS=1
MAX_CRITIC_LOOPS=2
MAX_INPUT_TOKENS=1000000
MAX_COST_PER_SESSION_USD=0.40
MAX_WALLCLOCK_SECONDS=420
CELERY_TASK_TIMEOUT_SECONDS=540
DEFAULT_MONTHLY_TOKEN_LIMIT=0
FRONTEND_URL=http://localhost:8501
UI_PORT=8501
API_PORT=8000

# Keep these identities unchanged when moving an existing installation.
COMPOSE_PROJECT_NAME=multi-agent
POSTGRES_VOLUME=multi_agent_postgres
REDIS_VOLUME=multi_agent_redis
CORPUS_VOLUME=multi_agent_corpus

